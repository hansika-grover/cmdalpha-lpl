# Sentinel: every number in the deck is regenerated by `make all`.
# On Windows without GNU make, use mingw32-make or run the python commands directly.
PY ?= python
SEEDS ?= 0 1 2 3 4

.PHONY: all world notes train eval seeds seeds-parallel export agent readme test clean

all: world notes eval seeds export agent readme

world:            ## synthetic book of business (config/world.yaml)
	$(PY) -m sentinel.generate --out data/world

notes:            ## Claude notes reader over the selected notes (uses the committed cache; needs ANTHROPIC_API_KEY for new notes)
	$(PY) -m sentinel.llm.notes_reader --world data/world

train eval:       ## train, calibrate, evaluate with bootstrap CIs and leave-one-typology-out
	$(PY) -m sentinel.eval.run_eval --world data/world --out results/metrics.json

seeds:            ## repeat on independent worlds (seeds 1-4) for stability
	$(PY) -m sentinel.eval.seeds --seeds $(SEEDS)

seeds-parallel:   ## same, one process per world, then summarize (seed 0 reuses results/metrics.json)
	for s in 1 2 3 4; do $(PY) -m sentinel.eval.seeds --one $$s > results/_seed_$$s.log 2>&1 & done; wait
	$(PY) -m sentinel.eval.seeds --summarize --seeds $(SEEDS)

export:           ## JSON for the dashboard
	$(PY) -m sentinel.export --world data/world

agent:            ## Claude case agent for every queued household (needs ANTHROPIC_API_KEY), then re-export
	$(PY) -m sentinel.llm.case_agent --world data/world && $(PY) -m sentinel.export --world data/world

readme:           ## results table in README.md from results/metrics.json
	$(PY) -m sentinel.export.readme

test:
	$(PY) -m pytest

clean:
	rm -rf data/world data/world_s* results/_*
